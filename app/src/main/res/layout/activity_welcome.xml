<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="24dp"
    android:paddingEnd="24dp" >

    <Space
        android:layout_width="100dp"
        android:layout_height="5dp"
        android:layout_weight="0.2" />

    <!-- 工作区卡片（深浅变化 + 圆角） -->
    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:text="欢迎！$user" />

    <!-- 底部占位，把按钮推到下方 -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="176dp"
        android:layout_height="195dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardBackgroundColor="@null"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/card_stroke_grey">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bd_gradient_card"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/afternoon_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="105dp"
                android:layout_weight="1"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_afternoon_vector"
                tools:layout_editor_absoluteX="16dp" />

            <TextView
                android:id="@+id/time_text"
                android:layout_width="77dp"
                android:layout_height="48dp"
                android:text="TextView"
                tools:layout_editor_absoluteX="15dp"
                tools:layout_editor_absoluteY="16dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="173dp"
        android:layout_height="211dp"
        android:layout_margin="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/card_stroke_grey">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                app:srcCompat="@drawable/ic_vector_notice" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.2" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text="您暂时没有通知 "
                android:textColor="@color/black"
                android:textSize="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" />

            <!-- 右侧确认按钮 -->


        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/skip_main_btn"
        android:layout_width="147dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.2"
        android:text="点击跳转" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:layout_weight="1" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </LinearLayout>

</LinearLayout>